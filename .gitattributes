# cmd.exe resolves labels unreliably in batch files with LF line endings, so
# batch files are always checked out (and archived from a checkout) as CRLF.
*.bat text eol=crlf
*.bat.tpl text eol=crlf
*.cmd text eol=crlf

# Artifact test inputs are hashed byte-for-byte
julia/private/tests/artifact/data/** -text
