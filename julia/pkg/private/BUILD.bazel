load("@bazel_skylib//:bzl_library.bzl", "bzl_library")
load(":julia_runtime.bzl", "julia_runtime")

exports_files([
    "pkg_compiler.jl",
    "pkg_compiler_driver.jl",
    "pkg_tester.jl",
    "pkg_tester_core.jl",
])

julia_runtime(
    name = "julia_runtime",
    visibility = ["//visibility:public"],
)

bzl_library(
    name = "bazel_tools_bzl_lib",
    srcs = ["@bazel_tools//tools:bzl_srcs"],
)

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//julia/pkg:__pkg__"],
    deps = [
        ":bazel_tools_bzl_lib",
        "@toml.bzl//:toml",
    ],
)
