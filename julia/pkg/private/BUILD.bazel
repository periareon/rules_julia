load("@bazel_skylib//:bzl_library.bzl", "bzl_library")

exports_files([
    "pkg_resolve.jl",
    "pkg_resolve_driver.jl",
    "pkg_tester.jl",
    "pkg_tester_core.jl",
])

bzl_library(
    name = "bazel_tools_bzl_lib",
    srcs = ["@bazel_tools//tools:bzl_srcs"],
)

bzl_library(
    name = "bzl_lib",
    srcs = glob(["*.bzl"]),
    visibility = ["//julia/pkg:__pkg__"],
    deps = [
        ":bazel_tools_bzl_lib",
        "//julia/private:bzl_lib",
        "@toml.bzl//:toml",
    ],
)
