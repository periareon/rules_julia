load("//julia:julia_test.bzl", "julia_test")

julia_test(
    name = "hash_test",
    srcs = ["hash_test.jl"],
)

config_setting(
    name = "dbg",
    values = {"compilation_mode": "dbg"},
)

# The toolchain's defaults per compilation mode.
julia_test(
    name = "julia_flags_test",
    srcs = ["julia_flags_test.jl"],
    env = select({
        ":dbg": {
            "EXPECTED_CHECK_BOUNDS": "1",
            "EXPECTED_DEBUG_INFO": "2",
            "EXPECTED_OPT_LEVEL": "0",
        },
        "//conditions:default": {
            "EXPECTED_CHECK_BOUNDS": "0",
            "EXPECTED_DEBUG_INFO": "1",
            "EXPECTED_OPT_LEVEL": "2",
        },
    }),
    julia_flags = ["--threads=3"],
)
