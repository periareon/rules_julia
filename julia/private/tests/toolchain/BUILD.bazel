load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("//julia:julia_toolchain.bzl", "julia_toolchain")
load(":toolchain_test.bzl", "julia_cfg_test")

# A generated `julia` so that its output path shows the configuration it was
# built in.
write_file(
    name = "fake_julia",
    out = "julia.sh",
    content = ["#!/bin/sh"],
    is_executable = True,
)

julia_toolchain(
    name = "fake_toolchain",
    julia = ":fake_julia",
    tags = ["manual"],
    version = "1.12.0",
)

julia_cfg_test(
    name = "julia_cfg_test",
    target_under_test = ":fake_toolchain",
)
